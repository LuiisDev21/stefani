<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="stefani.exe"
        Arguments=""
        InstallLocation="C:\Program Files\Stefani Project\STEFANI">
    </Installer>
    <PackageInformation
        PackageName="STEFANI"
        PackageDisplayName="STEFANI"
        PublisherName="CN=Stefani Project"
        PublisherDisplayName="Stefani Project"
        Version="0.1.0.0"
        PackageDescription="Reproductor musical y entorno de aprendizaje de ingles">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="app.stefani.desktop"
                Description="Reproductor musical y entorno de aprendizaje de ingles"
                DisplayName="STEFANI"
                ExecutableName="stefani.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>STEFANI</DisplayName>
            <PublisherDisplayName>Stefani Project</PublisherDisplayName>
            <Description>Reproductor musical y entorno de aprendizaje de ingles</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="stefani.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
